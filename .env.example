# ───────────── Variabili esposte al browser (prefisso VITE_) ─────────────
# Solo valori PUBBLICI. La anon key è pensata per il browser: la sicurezza
# dei dati è garantita dalle policy RLS, non dalla segretezza di questa chiave.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# URL pubblico dell'app (usato per i redirect email di Supabase Auth)
VITE_APP_URL=http://localhost:5173

# ───────────── Variabili SOLO server (Netlify Functions) ─────────────
# Impostale nel pannello Netlify → Site configuration → Environment variables.
# NON usare mai il prefisso VITE_ per queste chiavi: finirebbero nel bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role: usata SOLO dalle Netlify Functions del Lead Finder dopo i controlli
# di autorizzazione (scritture su candidati, job AI, quote). Mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# ───────────── AI Lead Finder: fonti dati ─────────────
# OpenStreetMap via Overpass. L'istanza pubblica overpass-api.de vieta l'uso commerciale
# e le app su netlify.app: usa un endpoint a pagamento o self-hosted (HTTPS obbligatorio).
OVERPASS_API_URL=
# Contatto incluso nello User-Agent, richiesto dalle policy Overpass (email o URL).
OVERPASS_CONTACT=
# Facoltativa: chiave del provider Overpass a pagamento (inviata come Bearer).
OVERPASS_API_KEY=
# Google Places API (New). Risultati solo in sessione: nessuna memorizzazione, export o CRM.
GOOGLE_PLACES_API_KEY=

# ───────────── AI Business Analyzer ─────────────
OPENAI_API_KEY=
# Obbligatorio: nessun modello predefinito nel codice (es. il modello consigliato nella documentazione OpenAI).
OPENAI_MODEL=
# Segreto casuale (min. 32 caratteri) per l'invocazione interna della background function.
# Generalo con: openssl rand -hex 32
LEADFLOW_INTERNAL_SECRET=

# ───────────── Fasi successive ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
