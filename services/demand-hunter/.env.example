# Demand Hunter service — copy to .env on the server (never commit it). One value per line.

# Shared with the Netlify gateway (same value as DEMAND_HUNTER_SERVICE_SECRET on Netlify). At least 32 chars.
# Generate with: openssl rand -hex 32
DEMAND_HUNTER_SERVICE_SECRET=

# true = simulated searches (free, offline, results marked "esempio-simulato"). false = real SerpApi searches.
DH_SIMULATED=true
# Read by the original BuyerML code: must be false for real searches.
MOCK_MODE=true
# SerpApi key, used only when DH_SIMULATED=false and MOCK_MODE=false.
SERPAPI_KEY=

# Hard caps of the service (the gateway also applies the per-organization monthly limits).
DH_MAX_BUDGET_PER_HUNT=100
DH_MAX_CONCURRENT_PER_ORG=1
DH_SIGNATURE_WINDOW_S=300
