{
  "name": "leadflow-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rls": "bash supabase/tests/run_local_rls_tests.sh",
    "test:billing-concurrency": "bash supabase/tests/run_billing_concurrency.sh",
    "stripe:preflight": "node scripts/stripe-preflight.mjs",
    "ai:eval": "vitest run netlify/functions/_shared/agents/__tests__/eval.test.ts",
    "integrations:preflight": "node scripts/integration-preflight.mjs",
    "staging:e2e": "node scripts/staging-e2e.mjs",
    "staging:isolation": "node scripts/staging-isolation.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "ai:benchmark": "BENCHMARK_REPORT_PATH=benchmark-report.json vitest run netlify/functions/_shared/agents/__tests__/training.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
